# Copy on the VM before first deploy: cp .env.example .env

# DuckDNS subdomain pointing to this VM's public IP (HTTPS via Caddy)
DOMAIN=meditrack-gateway.duckdns.org

# Downstream microservices
IAM_SERVICE_URL=https://meditrack-iam-gmh0b2eshgcpbmhw.eastus-01.azurewebsites.net
ORGANIZATION_SERVICE_URL=https://meditrack-organization.duckdns.org
RELATIVES_SERVICE_URL=https://meditrack-relatives-api-e2eyethkfgc4hbfh.eastus-01.azurewebsites.net
CLINICAL_SERVICE_URL=https://meditrack-clinical-hph0avgbe2ejbyew.eastus-01.azurewebsites.net

# Update when the devices microservice is deployed and reachable from this VM.
# Same-VM example: http://host.docker.internal:8383
# Public URL example: https://meditrack-devices.example.com
DEVICES_SERVICE_URL=http://host.docker.internal:8383

# Browser origins allowed to call the gateway (Firebase + local dev)
GATEWAY_CORS_ORIGINS=https://meditrack-pro-yvaal.web.app,https://meditrack-pro-yvaal.firebaseapp.com,http://localhost:4200
