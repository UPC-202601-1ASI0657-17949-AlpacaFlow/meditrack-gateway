# Copy before deploy: cp .env.example .env

# DuckDNS subdomain pointing to this VM's public IP (HTTPS via Caddy)
DOMAIN=meditrack-gateway.duckdns.org

# Downstream microservices (already deployed)
IAM_SERVICE_URL=https://meditrack-iam-gmh0b2eshgcpbmhw.eastus-01.azurewebsites.net
ORGANIZATION_SERVICE_URL=https://meditrack-organization.duckdns.org

# Browser origins allowed to call the gateway (Firebase + local dev)
GATEWAY_CORS_ORIGINS=https://meditrack-pro-yvaal.web.app,https://meditrack-pro-yvaal.firebaseapp.com,http://localhost:4200
